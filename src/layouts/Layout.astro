---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description = "Turn any Android phone or tablet into a fun, self-contained photo booth. Countdown timer, print, share, and kiosk mode — no account, works fully offline.", ogImage = "/images/feature_graphic.png" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absOgImage = new URL(ogImage, Astro.site);
const ogImageAlt = "JustBooth – turn any Android device into a photo booth";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "JustBooth",
      "description": "Turn any Android phone or tablet into a self-contained photo booth — countdown timer, instant print or share, and kiosk mode.",
      "url": Astro.site.toString(),
      "image": absOgImage.toString(),
      "applicationCategory": "EntertainmentApplication",
      "operatingSystem": "Android",
      "availableOnDevice": "Android",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      },
      "author": { "@type": "Organization", "name": "JustBooth" },
      "publisher": { "@type": "Organization", "name": "JustBooth" }
    },
    {
      "@type": "WebSite",
      "name": "JustBooth",
      "description": "DIY photo booth app for Android",
      "url": Astro.site.toString()
    }
  ]
};

import Footer from '../components/Footer.astro';
import NavBar from '../components/NavBar.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="photo booth, DIY photo booth, Android photo booth, kiosk photo booth, event photo booth, photo booth app, wedding photo booth, party photo booth, print photos, Olympus camera, kiosk mode, watermark, white label" />
    <meta name="author" content="JustBooth" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absOgImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="JustBooth" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="theme-color" content="#7c3aed" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/justbooth-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    <script is:inline set:html={JSON.stringify(schema)} type="application/ld+json"></script>
  </head>
  <body class="bg-white text-gray-900 antialiased flex flex-col min-h-screen">
    <NavBar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    height: 100%;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
</style>
