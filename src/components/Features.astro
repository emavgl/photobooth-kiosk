---
const features = [
  {
    title: 'Your Camera, Your Way',
    description: 'Works with the built-in camera on any Android device, supports Olympus mirrorless cameras over Wi-Fi, or use another Android phone as a remote camera.',
    icon: 'camera'
  },
  {
    title: 'Countdown & Instant Results',
    description: 'Configurable 3–10 second countdown with a custom message, then the photo appears instantly on the big screen with a fun compliment.',
    icon: 'timer'
  },
  {
    title: 'Print Your Photos',
    description: 'Works with any printing app on your device — Bluetooth, Wi-Fi, or USB. Pick a specific printer app or use the system default.',
    icon: 'print'
  },
  {
    title: 'Share on the Spot',
    description: 'No printer? No problem. Share photos instantly via any app on the device, or save them to the gallery and send them to guests later.',
    icon: 'share'
  },
  {
    title: 'True Kiosk Mode',
    description: 'Fullscreen, screen always on, Home button locked to the booth. Guests stay inside the photo experience the whole event.',
    icon: 'kiosk'
  },
  {
    title: 'Secure Admin Lock',
    description: 'A PIN or biometric lock keeps settings out of guests\' hands while you stay fully in control, mid-event.',
    icon: 'lock'
  },
  {
    title: 'Event Management',
    description: 'Group photos by event session, browse the event gallery, and watch the photo counter grow as the night goes on.',
    icon: 'folder'
  },
  {
    title: 'Offline & Private',
    description: 'No account, no data collection, no ads. Photos stay on your device and everything works fully offline at your event.',
    icon: 'shield'
  }
];

