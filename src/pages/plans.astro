---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Plans & Pricing – JustBooth Photo Booth App"
  description="Free photo booth app for Android, plus Personal and Business plans. Remove the watermark or add white-label branding. No account required, billed securely via Google Play.">

  <script is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site).toString() },
      { "@type": "ListItem", "position": 2, "name": "Plans & Pricing", "item": new URL('/plans', Astro.site).toString() }
    ]
  })} type="application/ld+json"></script>

  <section class="relative bg-white overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-violet-50 via-white to-fuchsia-50 pointer-events-none"></div>
    <div class="relative container mx-auto px-6 py-20 md:py-24">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-14">
          <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 tracking-tight">Simple plans for every event</h1>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Start free and upgrade whenever you need more. Personal and Business subscriptions are billed securely through Google Play — no JustBooth account or sign-up is required.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-0 items-stretch md:grid-rows-[auto_auto_auto_auto_auto_auto_1fr_auto]">
          <!-- Free -->
          <article class="flex flex-col md:grid md:row-span-8 md:grid-rows-subgrid md:gap-y-0 bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
            <span class="hidden md:block" aria-hidden="true"></span>
            <h2 class="text-xl font-bold text-gray-900 mb-1">Free</h2>
            <p class="text-sm text-gray-500 mb-4">The complete photo booth, ready to go.</p>
            <p class="text-3xl font-extrabold text-gray-900 mb-1">Free</p>
            <p class="text-sm text-gray-500 mb-6">no monthly fee</p>
            <p class="text-sm text-gray-700 mb-4"><span class="font-semibold text-gray-900">What's included:</span></p>
            <ul class="space-y-3 text-sm text-gray-700 flex-1 mb-8">
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Built-in camera, Olympus mirrorless or a remote phone as camera</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Configurable countdown with instant on-screen results</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Print via any printing app — Bluetooth, Wi-Fi or USB</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Share photos instantly or save them to the gallery</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> True kiosk mode with admin lock</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Event galleries and live photo counter</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> No account, no ads, works fully offline</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Photos include a subtle “Made with JustBooth” watermark</li>
            </ul>
            <a href="https://play.google.com/store/apps/details?id=eu.viglianisi.photobooth"
               target="_blank"
               rel="noopener noreferrer"
               class="block text-center px-6 py-3 bg-violet-600 text-white rounded-lg hover:bg-violet-700 transition-colors font-semibold text-sm shadow-sm">
              Download for free
            </a>
          </article>

          <!-- Personal -->
          <article class="flex flex-col md:grid md:row-span-8 md:grid-rows-subgrid md:gap-y-0 bg-white p-8 rounded-2xl border-2 border-violet-600 shadow-md">
            <span class="inline-block self-start justify-self-start text-xs font-semibold uppercase tracking-wide text-violet-700 bg-violet-50 px-3 py-1 rounded-full mb-4">Most popular</span>
            <h2 class="text-xl font-bold text-gray-900 mb-1">Personal</h2>
            <p class="text-sm text-gray-500 mb-4">For birthdays, weddings and private celebrations.</p>
            <p class="text-3xl font-extrabold text-gray-900 mb-1">
              <span data-price="personal_monthly">$4.55</span>
              <span class="text-sm font-semibold text-gray-500">/ month</span>
            </p>
            <p class="text-sm text-gray-500 mb-6">or <span data-price="personal_yearly">$18.24</span> / year</p>
            <p class="text-sm text-gray-700 mb-4"><span class="font-semibold text-gray-900">Everything in Free, plus:</span></p>
            <ul class="space-y-3 text-sm text-gray-700 flex-1 mb-8">
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Removes the watermark from your photos</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Customize the booth appearance</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Custom kiosk title, action buttons and countdown message</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Choose your own photo save location</li>
            </ul>
            <a href="https://play.google.com/store/apps/details?id=eu.viglianisi.photobooth"
               target="_blank"
               rel="noopener noreferrer"
               class="block text-center px-6 py-3 bg-violet-600 text-white rounded-lg hover:bg-violet-700 transition-colors font-semibold text-sm shadow-sm">
              Get it on Google Play
            </a>
          </article>

          <!-- Business -->
          <article class="flex flex-col md:grid md:row-span-8 md:grid-rows-subgrid md:gap-y-0 bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
            <span class="hidden md:block" aria-hidden="true"></span>
            <h2 class="text-xl font-bold text-gray-900 mb-1">Business</h2>
            <p class="text-sm text-gray-500 mb-4">For professional photo booth services.</p>
            <p class="text-3xl font-extrabold text-gray-900 mb-1">
              <span data-price="business_monthly">$18.28</span>
              <span class="text-sm font-semibold text-gray-500">/ month</span>
            </p>
            <p class="text-sm text-gray-500 mb-6">or <span data-price="business_yearly">$114.25</span> / year</p>
            <p class="text-sm text-gray-700 mb-4"><span class="font-semibold text-gray-900">Everything in Personal, plus:</span></p>
            <ul class="space-y-3 text-sm text-gray-700 flex-1 mb-8">
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Your logo and custom banner on every photo</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> White-label branding</li>
              <li class="flex gap-2"><span class="text-violet-600 font-bold">✓</span> Build a consistent brand at every event you run</li>
            </ul>
            <a href="https://play.google.com/store/apps/details?id=eu.viglianisi.photobooth"
               target="_blank"
               rel="noopener noreferrer"
               class="block text-center px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors font-semibold text-sm shadow-sm">
              Get it on Google Play
            </a>
          </article>
        </div>

        <div class="mt-12 bg-gray-50 border border-gray-200 rounded-2xl p-8 max-w-3xl mx-auto">
          <h2 class="text-lg font-bold text-gray-900 mb-3">Billing</h2>
          <ul class="space-y-2 text-sm text-gray-600">
            <li>• Personal and Business are subscriptions billed securely via Google Play — the same account you use to download the app.</li>
            <li>• Both are available with monthly or yearly billing; yearly plans are the best value.</li>
            <li>• Subscriptions renew automatically and you can cancel anytime from your Google Play account.</li>
            <li>• Prices are shown in your local currency where available, otherwise in US dollars; the exact price is confirmed in the app before you purchase.</li>
          </ul>
          <p class="text-sm text-gray-600 mt-4">See the <a href="/terms" class="text-violet-700 hover:underline">Terms &amp; Conditions</a> for subscription, withdrawal, warranty, and complaint information.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Prices come from Google Play (public/prices.json, regenerated with
  // `npm run prices`). We show the visitor's regional price when we can
  // determine their country and it exists in the Play price list, otherwise
  // we fall back to USD.
  const GEO_ENDPOINT = 'https://api.country.is/';
  const TIMEOUT_MS = 5000;

  interface PriceEntry {
    currency: string;
    amount: number;
  }

  interface PlanPrice {
    fallback: PriceEntry;
    regions?: Record<string, PriceEntry>;
  }

  interface Prices {
    plans: Record<string, PlanPrice>;
  }

  function formatPrice(entry: PriceEntry) {
    try {
      return new Intl.NumberFormat(navigator.language || undefined, {
        style: 'currency',
        currency: entry.currency,
        currencyDisplay: 'symbol',
      }).format(entry.amount);
    } catch {
      return `${entry.currency} ${entry.amount}`;
    }
  }

  function countryFromLocale() {
    for (const tag of navigator.languages || [navigator.language]) {
      if (!tag) continue;
      try {
        const region = new Intl.Locale(tag).region;
        if (region) return region;
      } catch {}
      const match = /[-_]([A-Za-z]{2})$/.exec(tag);
      if (match) return match[1].toUpperCase();
    }
    return null;
  }

  async function detectCountry() {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
    try {
      const response = await fetch(GEO_ENDPOINT, { signal: controller.signal });
      if (response.ok) {
        const data = await response.json();
        if (data && data.country) return String(data.country).toUpperCase();
      }
    } catch {
    } finally {
      clearTimeout(timer);
    }
    return countryFromLocale();
  }

  async function applyPrices() {
    const nodes = document.querySelectorAll<HTMLElement>('[data-price]');
    if (nodes.length === 0) return;

    let prices: Prices;
    try {
      const response = await fetch(`${import.meta.env.BASE_URL}prices.json`, { cache: 'no-cache' });
      if (!response.ok) throw new Error(String(response.status));
      prices = await response.json();
    } catch {
      return;
    }

    const country = await detectCountry();
    nodes.forEach((el) => {
      const key = el.dataset.price;
      const plan = key ? prices.plans[key] : undefined;
      if (!plan) return;
      const regional = country && plan.regions ? plan.regions[country] : null;
      const entry = regional || plan.fallback;
      if (entry) el.textContent = formatPrice(entry);
    });
  }

  applyPrices();
</script>
